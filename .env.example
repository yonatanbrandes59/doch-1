# ─────────────────────────────────────────────────────────────
#  הגדרות סביבה — העתק קובץ זה ל-.env ומלא ערכים
# ─────────────────────────────────────────────────────────────

# Supabase — להפעלת סנכרון אמיתי בין כל הרכזים.
# אם שני הערכים ריקים, האפליקציה עובדת אוטומטית מול localStorage (מצב פיתוח/דמו).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# קוד כניסה לחמ"ל — למצב פיתוח מקומי בלבד (ברירת מחדל 1948).
# בפרודקשן (Supabase מוגדר) הקוד אינו בשימוש — ההתחברות היא דרך Supabase Auth
# עם אימייל וסיסמה, וההרשאות נאכפות ב-RLS לפי תפקיד וסניף.
VITE_HAML_CODE=1948
