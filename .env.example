# ─────────────────────────────────────────────────────────────

# Supabase — להפעלת סנכרון אמיתי בין כל הרכזים.
# אם שני הערכים ריקים, האפליקציה עובדת אוטומטית מול localStorage (מצב פיתוח/דמו).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# קוד כניסה לחמ"ל (ברירת מחדל 1948 אם ריק).
# בפרודקשן מומלץ לעבור ל-Supabase Auth במקום קוד גישה.
VITE_HAML_CODE=1948
